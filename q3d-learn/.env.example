# Q-3D Learn — environment configuration (copy to .env; .env is gitignored).
# Never commit real secrets. Leave blank to use the built-in offline tutor.

# AI tutor (Q-Bot). Pick a provider or leave blank for the offline tutor.
# AI_PROVIDER=auto
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Optional key for the project's AI bot / voice provider (e.g. Sarvam).
# Read from the environment only — kept config-ready for future wiring.
# AI_BOT_API_KEY=

# Database (SQLite by default; set for PostgreSQL in production).
# DATABASE_URL=sqlite:///q3d_learn.db
